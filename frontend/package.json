{
  "name": "data-product-ops-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "frontend-only",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "verify:mapping": "esbuild scripts/verify-mapping.mts --bundle --platform=node --format=esm --target=es2022 --alias:@=./src --outfile=node_modules/.cache/verify-mapping.mjs && node node_modules/.cache/verify-mapping.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.23.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "esbuild": "^0.21.5",
    "typescript": "^5.4.3",
    "vite": "^5.2.6"
  }
}
